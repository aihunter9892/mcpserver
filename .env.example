# --- Backend ------------------------------------------------------------
# Which backend to use: groq (default) or anthropic
LLM_PROVIDER=groq

# Only the key for your chosen provider is required.
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=openai/gpt-oss-120b

ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# --- Server -------------------------------------------------------------
PORT=8000
LOG_LEVEL=INFO

# --- Production guards --------------------------------------------------
# Leave MCP_AUTH_TOKEN empty and the server is OPEN to anyone with the URL.
# That is fine for a workshop on a free-tier key. Set it before you point a
# paid key at a public deployment.
MCP_AUTH_TOKEN=

# Requests per minute per client IP. 0 disables limiting.
RATE_LIMIT_PER_MIN=30

# Reject tool arguments longer than this, before spending any tokens.
MAX_INPUT_CHARS=20000

# Reject HTTP bodies larger than this many bytes.
MAX_BODY_BYTES=1000000

# Upstream LLM call timeout and retry count.
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
